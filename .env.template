
# Website Toolbox endpoints. These normally do not need to change.
API_URL = "https://api.websitetoolbox.com/v1"
ADMIN_URL = "https://www.websitetoolbox.com/tool/members"

# Local paths. Relative paths are resolved from the directory where the command
# is run. Only EXPORT_DIR/posts.csv is used from a Website Toolbox content export.
EXPORT_DIR = "csv"
DOWNLOAD_DIR = "downloads"
OUTPUT_DIR = "output"

# Image host URLs. Include a trailing slash.
#
# Get OLD_URL and OLD_URL_THUMB by inspecting the current forum image URLs.
# XXXXXX is a Website Toolbox identifier; YYYYYY identifies the forum.
OLD_URL = "https://XXXXXX.cloudfront.net/YYYYYY/"
OLD_URL_THUMB = "https://XXXXXX.cloudfront.net/thumb/YYYYYY/"
NEW_URL = "https://new-image-host-domain/images/"

# Process all posts except those from the last SKIP_DAYS days.
SKIP_DAYS = 30

# For testing, process only one post. Leave blank to process all posts.
TEST_POST_ID = 

# Dry-run is the safe default. It prevents remote updates/deletes and also limits
# some collection/download work. The CLI flags --dry-run and --apply override
# this setting; --apply is recommended when intentionally running a full migration.
DRY_RUN = true
